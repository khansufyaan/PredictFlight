# --- chain ---
# Base mainnet: https://mainnet.base.org   Base Sepolia: https://sepolia.base.org
RPC_URL=https://mainnet.base.org
# key of the oracle signer (must match the oracle address set on FlightMarket)
ORACLE_PRIVATE_KEY=0x...
# Base mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
FLIGHT_MARKET_ADDRESS=0x...

# --- service ---
PORT=4000
ADMIN_SECRET=change-me
DATABASE_URL=file:./prisma/dev.db

# --- flight data ---
# mock | aeroapi
FLIGHT_PROVIDER=aeroapi
AEROAPI_KEY=

# --- job intervals (ms), defaults shown ---
# INGEST_INTERVAL_MS=21600000
# WATCHER_INTERVAL_MS=120000
# INDEXER_INTERVAL_MS=15000

# --- MockProvider pacing (local dev only) ---
# MOCK_DEPARTS_IN_SEC=45
# MOCK_FLIGHT_DURATION_SEC=30
# MOCK_FORCE_OUTCOME=ON_TIME
